# --- API server (npm run api) ---
OPENAI_API_KEY=sk-your-real-openai-key
OPENAI_MODEL=gpt-4.1
PORT=8787
HOST=0.0.0.0
NODE_ENV=development

# Set to "true" in production so the server refuses to start without a real key
REQUIRE_OPENAI_KEY=false

# Optional comma-separated list for Expo web (mobile apps ignore CORS)
# CORS_ORIGINS=https://your-web-app.example.com

# --- Mobile app (npm start / EAS build) ---
# Simulator:
EXPO_PUBLIC_API_BASE_URL=http://localhost:8787
# Physical phone on same Wi‑Fi (use your Mac IP):
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.165:8787
# Production App Store build:
# EXPO_PUBLIC_API_BASE_URL=https://your-api.onrender.com
